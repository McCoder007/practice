{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/milady-review-question-bank.schema.json",
  "title": "Milady Exam Review (8th ed.) Bilingual Pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "language", "sourceTitle", "generatedAt", "releaseState", "statistics", "questions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "translation"],
      "properties": {
        "source": { "const": "en" },
        "translation": { "const": "zh-Hans" }
      }
    },
    "sourceTitle": { "const": "Exam Review for Milady Standard Nail Technology, 8th Edition" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "releaseState": { "const": "active" },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "bySection"],
      "properties": {
        "total": { "const": 1148 },
        "bySection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["foundations", "nails", "comprehensive"],
          "properties": {
            "foundations": { "const": 387 },
            "nails": { "const": 661 },
            "comprehensive": { "const": 100 }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1148,
      "maxItems": 1148,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "en", "zh"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-d]$" },
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "printedPage", "pdfPage", "answerKeyPrintedPage", "answerKeyPdfPage"],
      "properties": {
        "book": { "const": "Exam Review for Milady Standard Nail Technology, 8th Edition" },
        "printedPage": { "type": "integer", "minimum": 1 },
        "pdfPage": { "type": "integer", "minimum": 1 },
        "answerKeyPrintedPage": { "type": "integer", "minimum": 1 },
        "answerKeyPdfPage": { "type": "integer", "minimum": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionChecked", "choicesChecked", "answerKeyChecked", "translationChecked"],
      "properties": {
        "questionChecked": { "type": "boolean" },
        "choicesChecked": { "type": "boolean" },
        "answerKeyChecked": { "type": "boolean" },
        "translationChecked": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "section", "chapter", "chapterTitle", "collection", "questionNumber", "type",
        "question", "choices", "correctChoice", "choicesOrigin", "status", "source",
        "verification", "originalArchiveId"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^milady-review-(foundations-[0-9]{2}-[0-9]{3}|nails-[0-9]{2}-[0-9]{3}|comprehensive-[0-9]{3})$" },
        "section": { "enum": ["foundations", "nails", "comprehensive"] },
        "chapter": { "type": "integer", "minimum": 0, "maximum": 13 },
        "chapterTitle": { "$ref": "#/$defs/localizedText" },
        "collection": { "enum": ["chapter-review", "comprehensive-exam"] },
        "questionNumber": { "type": "integer", "minimum": 1 },
        "type": { "const": "multiple-choice" },
        "question": { "$ref": "#/$defs/localizedText" },
        "choices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/choice" }
        },
        "correctChoice": { "type": "string", "pattern": "^[a-d]$" },
        "choicesOrigin": { "const": "source" },
        "status": { "const": "approved" },
        "source": { "$ref": "#/$defs/source" },
        "verification": { "$ref": "#/$defs/verification" },
        "originalArchiveId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
