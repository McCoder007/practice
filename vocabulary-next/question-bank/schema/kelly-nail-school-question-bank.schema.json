{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/kelly-nail-school-question-bank.schema.json",
  "title": "Kelly Nail School bilingual question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "language", "sourceTitle", "generatedAt", "releaseState", "statistics", "questions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "translation"],
      "properties": { "source": { "const": "en" }, "translation": { "const": "zh-Hans" } }
    },
    "sourceTitle": { "const": "Kelly Nail School — NAILS (EN) 2026" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "releaseState": { "const": "active" },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total"],
      "properties": { "total": { "const": 89 } }
    },
    "questions": {
      "type": "array",
      "minItems": 89,
      "maxItems": 89,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "zh": { "type": "string", "minLength": 1 } }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "en", "zh"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-d]$" },
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "questionNumber", "type", "question", "choices", "correctChoice", "textOrigin", "choicesOrigin", "status", "source", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^kelly-[0-9]{3}$" },
        "questionNumber": { "type": "integer", "minimum": 1, "maximum": 89 },
        "type": { "const": "multiple-choice" },
        "question": { "$ref": "#/$defs/localizedText" },
        "choices": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/choice" } },
        "correctChoice": { "type": "string", "pattern": "^[a-d]$" },
        "textOrigin": { "enum": ["source", "source-repaired"] },
        "choicesOrigin": { "enum": ["source", "source-repaired"] },
        "status": { "const": "approved" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["photos", "answerSource", "auditNote"],
          "properties": {
            "photos": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^IMG_[0-9]{4}\\.JPG$" } },
            "answerSource": { "type": "string", "minLength": 1 },
            "auditNote": { "type": "string" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questionChecked", "choicesChecked", "answerKeyChecked", "translationChecked"],
          "properties": {
            "questionChecked": { "const": true },
            "choicesChecked": { "const": true },
            "answerKeyChecked": { "const": true },
            "translationChecked": { "const": true }
          }
        }
      }
    }
  }
}
