{
  "name": "vocabulary-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate:source-audit": "node question-bank/scripts/validate-source-audit.js",
    "validate:release": "node question-bank/scripts/validate-release.js",
    "audit:teaching-copy": "node question-bank/scripts/audit-teaching-copy.js",
    "verify:sources": "python3 -B question-bank/scripts/verify_sources.py",
    "build:practice-bank": "python3 -B question-bank/scripts/build_practice_bank.py",
    "assemble:official-practice": "node question-bank/scripts/assemble-official-practice.js",
    "validate:official-practice": "node question-bank/scripts/validate-official-practice.js",
    "copy:pdf-worker": "mkdir -p public/pdfjs && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdfjs/pdf.worker.min.mjs",
    "postinstall": "npm run copy:pdf-worker",
    "prebuild": "npm run copy:pdf-worker && npm run validate:release",
    "test:qa-reel": "node --experimental-strip-types --test lib/nail-technician-qa-reel.test.mjs",
    "test:exam-quiz": "npm run validate:release && node --experimental-strip-types --test lib/exam-quiz-reel.test.mjs",
    "test": "node --experimental-strip-types --test lib/*.test.mjs question-bank/scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "framer-motion": "^12.9.4",
    "lucide-react": "^0.503.0",
    "next": "15.3.1",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5"
  }
}
